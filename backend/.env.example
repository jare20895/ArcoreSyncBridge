# Database
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=arcore_syncbridge
POSTGRES_HOST=localhost
POSTGRES_PORT=5465
DATABASE_URL=postgresql://change_me:change_me@localhost:5465/arcore_syncbridge

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change_this_in_production_to_a_long_random_string
ALGORITHM=HS256
AUTH_MODE=disabled
AUTH_HEADER_EMAIL=X-User-Email
AUTH_HEADER_ROLE=X-User-Role
AUTH_DISABLED_ROLE=platform_admin
AUTH_DEFAULT_ROLE=viewer
AUTH_AUTO_PROVISION_USERS=true

# Microsoft Graph
AZURE_TENANT_ID=change_me
AZURE_CLIENT_ID=change_me
AZURE_CLIENT_SECRET=change_me
